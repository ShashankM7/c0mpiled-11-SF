# --- Server ---
PORT=8787                        # HTTP port the API listens on
DEMO_MODE=auto                   # auto = live where keys exist, fixture otherwise | fixture = never touch the network | live = force live paths
ADAPTER_TIMEOUT_MS=4000          # hard timeout per external adapter call; on timeout the fixture is served
UNITS_PER_PALLET=16              # pallet math for freight quoting (16 stackable chairs per pallet)
CAPTURE=0                        # 1 = write successful live adapter responses into fixtures/ (used by npm run capture)
AUTH_SECRET=                     # HMAC secret for session tokens; a dev default is used when empty

# --- Vendors (all optional — a missing key disables that adapter's live path, fixtures serve instead) ---
CHANNEL3_API_KEY=                # Channel3 product search API key
CHANNEL3_BASE_URL=               # Override Channel3 base URL (useful for testing fallback)
CRUSTDATA_API_KEY=               # CrustData company-enrichment API key
CRUSTDATA_BASE_URL=              # Override CrustData base URL
VOYGR_API_KEY=                   # VOYGR place/business verification API key
VOYGR_BASE_URL=                  # Override VOYGR base URL
OWAY_API_KEY=                    # Oway LTL freight quoting API key
OWAY_BASE_URL=                   # Override Oway base URL
CALLWRIGHT_API_KEY=              # Callwright outbound-calling API key
CALLWRIGHT_BASE_URL=             # Override Callwright base URL
PHONELY_API_KEY=                 # Phonely inbound-call API key
PHONELY_WEBHOOK_SECRET=          # Shared secret checked on POST /api/webhooks/phonely (x-phonely-signature)

# --- Identity ---
IDENTITY_PROVIDER=local          # local = seeded users + our own tokens | hexclave = Hexclave-backed IdentityProvider
HEXCLAVE_API_KEY=                # Hexclave API key (only used when IDENTITY_PROVIDER=hexclave)
HEXCLAVE_BASE_URL=               # Override Hexclave base URL

# --- LLM parsing (optional — regex extractor + fixture parse cover the no-key case) ---
ANTHROPIC_API_KEY=               # If set, the parser makes one JSON-mode LLM call before falling back to regex
OPENAI_API_KEY=                  # Alternative LLM key; Anthropic is preferred when both are set

# --- Demo calling ---
DEMO_CALL_NUMBER=                # The one consenting phone number outbound demo calls are placed to
