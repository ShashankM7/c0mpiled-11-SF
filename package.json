{
  "name": "procureos",
  "version": "0.1.0",
  "private": true,
  "description": "ProcureOS — an agentic purchasing department: cinematic frontend + orchestration backend in one repo",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/procure-demo.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "api:dev": "tsx watch src/server.ts",
    "api:build": "tsc -p tsconfig.build.json",
    "api:test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "capture": "CAPTURE=1 tsx scripts/capture.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@types/three": "^0.185.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.2.0",
    "next": "16.2.6",
    "pino": "^9.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^2.1.8",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
