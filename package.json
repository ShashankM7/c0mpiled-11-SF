{
  "name": "procureos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ProcureOS — AI-native procurement agent backend (HTTP + SSE contract for a separate frontend)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "capture": "CAPTURE=1 tsx scripts/capture.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
